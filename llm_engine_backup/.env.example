# ── OpenAI (used by the main app server) ────────────────────────────────────
OPENAI_API_KEY=your-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1

# ── Optional model overrides (main app) ──────────────────────────────────────
# CHAT_MODEL=gpt-3.5-turbo
# EMBEDDING_MODEL=text-embedding-3-small

# ── Server ────────────────────────────────────────────────────────────────────
# HOST=127.0.0.1
# PORT=8000
# RELOAD=true
# LOG_LEVEL=info

# ── Evaluation (rag_evaluator / scripts/run_evaluation.py) ───────────────────
# The evaluator uses a LOCAL Ollama instance instead of the remote API token.
# This avoids bot-detection bans from free-tier providers (e.g. ChatAnywhere).
#
# Make sure Ollama is running:  ollama serve
# Pull the models first:
#   ollama pull nomic-embed-text    ← for embeddings
#   ollama pull llama3              ← or whatever model matches your main app

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3           # set to the same model you use in the main app
OLLAMA_EMBED_MODEL=nomic-embed-text

# App server URL (must be running before starting evaluation)
# EVAL_BASE_URL=http://127.0.0.1:8000

# Human-like pacing between requests (seconds) — reduce for faster local runs
# PACE_MIN=2.5
# PACE_MAX=5.5
# THINK_PAUSE_MIN=4.0
# THINK_PAUSE_MAX=8.0
